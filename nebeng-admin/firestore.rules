rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['pidzgantengbanget18@pidzstore.com'];
    }

    // Server boleh dibaca siapa aja (buat landing page), tapi cuma admin yang boleh nulis
    match /servers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders, buyers, reset_requests: cuma admin (lewat panel) yang boleh baca.
    // Buyer TIDAK baca/tulis langsung ke sini - semua lewat API (/api/...) yang pakai firebase-admin,
    // yang otomatis bypass rules ini.
    match /orders/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /buyers/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /reset_requests/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Pengaturan pembayaran QRIS otomatis, diatur lewat panel admin
    match /settings/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
